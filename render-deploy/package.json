{
  "name": "chatbot---factory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "server": "node backend/server.js",
    "backend": "node backend/server.js",
    "build": "node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build",
    "lint": "node node_modules/oxlint/bin/oxlint",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test:domain": "node tests/verify_domain.mjs",
    "test:sweep": "node tests/sweep_domain.mjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "seed": "node scripts/seed-demo.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"backend/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"backend/**/*.js\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:migrate-legacy": "node scripts/migrate-legacy-data.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@prisma/client": "^6.19.3",
    "@xyflow/react": "^12.11.3",
    "bcryptjs": "^3.0.3",
    "cmdk": "^1.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "framer-motion": "^13.1.1",
    "groq-sdk": "^1.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.33.0",
    "mammoth": "^1.12.1",
    "multer": "^2.2.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.4",
    "better-sqlite3": "^13.0.3",
    "husky": "^9.1.7",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
