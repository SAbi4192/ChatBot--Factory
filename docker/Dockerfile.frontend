# ============================================================
# Scarlet Chatbot Factory — frontend image
# Builds the React app, serves it with nginx (port 80).
# /api, /widget.js and /widget/* are proxied to the backend.
# ============================================================
FROM node:20-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build

# ---- Serve stage ----
FROM nginx:alpine

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
