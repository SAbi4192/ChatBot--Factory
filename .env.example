# ============================================================
# Universal Chatbot Factory — environment template
# Copy this file to ".env" and fill in your keys.
#   cp .env.example .env       (macOS/Linux)
#   copy .env.example .env     (Windows)
# The real .env is git-ignored and must NEVER be committed.
# ============================================================

# ---- AI routing mode --------------------------------------------------------
# auto  = domain-guard, then local model for normal queries and web AI for
#         "current info" queries (recommended for the demo)
# local = always use the local GGUF model (never call the web)
# groq  = always use Groq  |  gemini = always use Gemini
AI_PROVIDER=auto

# ---- Cloud AI keys (optional; enable web-enhanced answers + fallback) -------
# Groq:   https://console.groq.com/keys      (key starts with "gsk_")
# Gemini: https://aistudio.google.com/apikey  (used only if Groq is unavailable)
GROQ_API_KEY=your_groq_key_here
GEMINI_API_KEY=your_gemini_key_here

# ---- Model names (only change if a provider renames a model) ----------------
GROQ_WEB_MODEL=openai/gpt-oss-20b
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GEMINI_MODEL=gemini-3.6-flash

# ---- Backend + local LLM server ---------------------------------------------
PORT=3001
LOCAL_LLM_URL=http://127.0.0.1:8000/api/chat
# LOCAL_MODEL_PATH=./models/llm-model.gguf
# LLM_N_CTX=4096
# LOCAL_LLM_PORT=8000

# ---- CORS allowlist (optional) -------------------------------------------------
# Comma-separated list of origins allowed to call the API cross-origin.
# Same-origin requests (the Vite dev proxy and the production build served by
# the backend itself) never send an Origin header and are always allowed, so
# this can stay empty for local development.
# Example: CORS_ORIGINS=http://localhost:5173,https://chatbot.example.com
CORS_ORIGINS=

# SQLite database for Prisma ORM (path relative to prisma/schema.prisma)
DATABASE_URL="file:../data/chatbot_factory.db"

# ---- Auth (JWT) ----
# Secret used to sign tokens. CHANGE THIS in production (any long random string).
JWT_SECRET=dev-secret-change-me-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Bootstrap admin created on first start (only when the DB has legacy bots):
BOOTSTRAP_ADMIN_EMAIL=admin@factory.local
BOOTSTRAP_ADMIN_PASSWORD=admin123
BOOTSTRAP_ADMIN_NAME=Factory Admin
