      { "id": "answer", "label": "2. Question to grounded answer", "focus": ["user", "guard", "hook", "search", "augment", "llm", "reply"], "note": "Every chat message: guard first, then top-5 matching chunks are injected into the prompt so the LLM answers from facts." },
      { "id": "fallback", "label": "3. When KB has nothing", "focus": ["search", "plain", "llm"], "note": "No matching chunks → the message passes through unmodified; plain LLM answer, no fake citations." }
